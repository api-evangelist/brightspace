{
  "opencollection": "1.0.0",
  "info": {
    "name": "D2L Brightspace Valence Learning Framework Assignments Learning Outcomes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.brightspace.com/oauth2/auth",
      "accessTokenUrl": "https://auth.brightspace.com/core/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Learning Outcomes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List organization outcome sets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/d2l/api/le/1.92/lo/outcomeSets/"
          },
          "docs": "Retrieves the learning outcome sets defined at the organization level."
        },
        {
          "info": {
            "name": "Create an organization outcome set",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}/d2l/api/le/1.92/lo/outcomeSets/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new learning outcome set at the organization level."
        },
        {
          "info": {
            "name": "List outcome alignments for an org unit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/d2l/api/le/1.92/:orgUnitId/lo/alignments/",
            "params": [
              {
                "name": "orgUnitId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the learning outcome alignments within a course offering."
        }
      ]
    }
  ],
  "bundled": true
}